{% extends 'base.html.twig' %}

{% block title %}Профиль / StudyOn{% endblock %}

{% block body %}
    <main class="container">
        {% for message in app.flashes('danger') %}
            <div class="alert alert-danger">
                {{ message }}
            </div>
        {% endfor %}

        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-white">
                        <h1 class="h4 mb-0">Профиль</h1>
                    </div>

                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Email</dt>
                            <dd class="col-sm-8">{{ email }}</dd>

                            <dt class="col-sm-4">Роль</dt>
                            <dd class="col-sm-8">
                                {% if role == 'Администратор' %}
                                    <span class="badge bg-danger">{{ role }}</span>
                                {% else %}
                                    <span class="badge bg-primary">{{ role }}</span>
                                {% endif %}
                            </dd>

                            <dt class="col-sm-4">Баланс</dt>
                            <dd class="col-sm-8">{{ balance|number_format(2, '.', ' ') }}</dd>
                        </dl>
                    </div>

                    <div class="card-footer bg-white d-flex justify-content-between">
                        <a href="{{ path('app_course_index') }}" class="btn btn-outline-secondary">
                            К списку курсов
                        </a>

                        <a href="{{ path('app_logout') }}" class="btn btn-outline-danger">
                            Выйти
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %}