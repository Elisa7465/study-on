{% extends 'base.html.twig' %}

{% block title %}Доступ запрещен / StudyOn{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="mx-auto" style="max-width: 760px;">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5">
                    <h1 class="h3 mb-3">Доступ запрещен</h1>
                    <p class="text-body-secondary mb-4">
                        У вас недостаточно прав для выполнения этого действия.
                    </p>

                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-primary" href="{{ path('app_login') }}">Войти</a>
                        <a class="btn btn-outline-secondary" href="{{ path('app_course_index') }}">К списку курсов</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
