{% extends 'base.html.twig' %}

{% block title %}{{ course.title }} / StudyOn{% endblock %}

{% block body %}
    {% set isFree = billing_course.type is not defined or billing_course.type == 'free' %}
    {% set coursePrice = billing_course.price ?? billing_course.cost ?? 0 %}
    {% set hasPayment = payment is not null %}
    {% set canViewLessons = is_granted('ROLE_USER') and (isFree or hasPayment) %}
    {% set isRented = hasPayment and ((payment.expires_at is defined and payment.expires_at) or (payment.expiresAt is defined and payment.expiresAt)) %}
    {% set rentExpiresAt = isRented ? (payment.expires_at ?? payment.expiresAt) : null %}
    {% set actionLabel = billing_course.type is defined and billing_course.type == 'rent' ? 'Арендовать' : 'Купить' %}
    {% set canAfford = user_balance is not null and user_balance >= coursePrice %}

    <div class="container py-4">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="{{ path('app_course_index') }}">Курсы</a></li>
                <li class="breadcrumb-item active" aria-current="page">{{ course.title }}</li>
            </ol>
        </nav>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
                    <div>
                        <h1 class="mb-3">{{ course.title }}</h1>

                        {% if course.description %}
                            <p class="text-body-secondary mb-3">{{ course.description }}</p>
                        {% else %}
                            <p class="text-body-secondary mb-3">Описание пока не добавлено.</p>
                        {% endif %}

                        <div class="d-flex flex-wrap gap-2">
                            {% if isFree %}
                                <span class="badge text-bg-success">Бесплатно</span>
                            {% else %}
                                <span class="badge text-bg-light border">Цена: {{ coursePrice }}</span>
                            {% endif %}

                            {% if hasPayment %}
                                {% if isRented %}
                                    <span class="badge text-bg-warning">Арендовано до {{ rentExpiresAt|date('d.m.Y H:i') }}</span>
                                {% else %}
                                    <span class="badge text-bg-primary">Куплено</span>
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 align-self-start">
                        <a class="btn btn-outline-secondary" href="{{ path('app_course_index') }}">К списку</a>

                        {% if is_granted('ROLE_USER') and not isFree and not hasPayment %}
                            {% if canAfford %}
                                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#payCourseModal">{{ actionLabel }}</button>
                            {% else %}
                                <button type="button" class="btn btn-success" disabled title="Недостаточно средств на балансе">{{ actionLabel }}</button>
                            {% endif %}
                        {% endif %}

                        {% if is_granted('ROLE_SUPER_ADMIN') %}
                            <a class="btn btn-outline-primary" href="{{ path('app_course_edit', {'id': course.id}) }}">Редактировать</a>
                            <a class="btn btn-primary" href="{{ path('app_lesson_new', {'course_id': course.id}) }}">Добавить урок</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h2 class="h4 mb-0">Уроки</h2>
                    <span class="badge text-bg-primary">{{ lessons|length }}</span>
                </div>

                {% if lessons is not empty %}
                    <div class="list-group list-group-flush">
                        {% for lesson in lessons %}
                            {% if canViewLessons %}
                                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href="{{ path('app_lesson_show', {'id': lesson.id}) }}">
                                    <span>{{ lesson.title }}</span>
                                    <span class="badge text-bg-light border">Открыть</span>
                                </a>
                            {% else %}
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>{{ lesson.title }}</span>
                                    <span class="badge text-bg-secondary">Войдите для просмотра</span>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="alert alert-light border mb-0">Уроков пока нет.</div>
                {% endif %}
            </div>
        </div>

        {% if is_granted('ROLE_SUPER_ADMIN') %}
            <div class="mt-3">{{ include('course/_delete_form.html.twig') }}</div>
        {% endif %}
    </div>

    {% if is_granted('ROLE_USER') and not isFree and not hasPayment and canAfford %}
        <div class="modal fade" id="payCourseModal" tabindex="-1" aria-labelledby="payCourseModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="payCourseModalLabel">Подтверждение оплаты</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">{{ actionLabel }} курс <strong>{{ course.title }}</strong> за <strong>{{ coursePrice }}</strong>?</div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Отмена</button>
                        <a href="{{ path('app_course_pay', {'id': course.id}) }}" class="btn btn-success">{{ actionLabel }}</a>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
